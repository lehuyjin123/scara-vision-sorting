    color: #c000000; /* Màu đỏ đô (Hex code) */
    
    /* 2. Cỡ chữ (Font Size) */
    font-size: 12px; /* Kích thước 20 pixels */
    
    /* 3. In đậm (Font Weight) */
    font-weight: bold; /* Làm chữ in đậm */
    
    /* Các tùy chỉnh phông chữ khác (tùy chọn) */
    font-family: &quot;Arial&quot;, sans-serif; /* Đặt kiểu font */
    
    /* Các tùy chỉnh nền (tùy chọn) */
    background-color: transparent; /* Nền trong suốt (mặc định) */
    /* background-color: #fcfcfc; */ /* Nếu muốn có nền màu */
    
    /* Các tùy chỉnh đường viền (tùy chọn) */
    /* border: 1px solid #c0392b; */
    /* border-radius: 4px; */
    /* padding: 5px; */
}
</string>
