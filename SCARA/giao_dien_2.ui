      <widget class="QPushButton" name="senddo_3">
       <property name="geometry">
        <rect>
         <x>310</x>
         <y>130</y>
         <width>71</width>
         <height>31</height>
        </rect>
       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton {
    /* Trạng thái mặc định */
    background-color: #007bff; /* Màu xanh dương cơ bản */
    color: white;
    border: none;
        padding: 4px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: bold;
    transition: background-color 0.3s ease; /* (Gợi ý: Dùng trong PySide/PyQt, có thể không thấy hiệu ứng trong Designer) */
}

QPushButton:hover {
    /* Khi di chuột qua (mouse hover) */
    background-color: #0056b3; /* Màu xanh dương đậm hơn */
    border: 2px solid #004085;
    cursor: pointer; /* Thay đổi con trỏ chuột (có thể không hoạt động trong Designer) */
}

QPushButton:pressed {
    /* Khi nút được nhấn xuống (mouse button pressed) */
    background-color: #004085; /* Màu xanh đậm nhất */
    padding-top: 14px; /* Tạo hiệu ứng &quot;nhấn xuống&quot; bằng cách thay đổi đệm */
    padding-bottom: 10px;
}

QPushButton:disabled {
    /* Khi nút bị vô hiệu hóa (disable) */
    background-color: #cccccc;
    color: #666666;
    border: 1px solid #999999;
}</string>
