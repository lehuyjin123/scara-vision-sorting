        </rect>
       </property>
       <property name="styleSheet">
        <string notr="true">QTextEdit {
    /* Màu nền và màu chữ mặc định */
    background-color: #ffffff; /* Nền trắng */
    color: #333333; /* Màu chữ xám đậm */
    
    /* Thiết lập đường viền */
    border: 1px solid #cccccc; /* Viền mỏng màu xám */
    border-radius: 5px; /* Bo tròn góc */
    
    /* Khoảng đệm (padding) bên trong */
    padding: 2px; 
    
    /* Cấu hình phông chữ */
    font-size: 12px;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}

QTextEdit:focus {
    /* Khi widget được chọn (nhấp vào) */
    border: 2px solid #007bff; /* Viền dày hơn, màu xanh dương nổi bật */
    background-color: #f0f8ff; /* Nền hơi xanh nhạt */
}

QTextEdit:read-only {
    /* Khi QTextEdit chỉ ở chế độ đọc (không thể chỉnh sửa) */
    background-color: #f5f5f5; /* Nền xám nhạt */
    color: #666666; /* Màu chữ xám mờ hơn */
    border: 1px dashed #aaaaaa; /* Viền nét đứt */
}</string>
