      <property name="styleSheet">
       <string notr="true">QGroupBox::title {
    /* Khắc phục lỗi cú pháp: Màu chữ đen */
    color: rgb(0, 0, 0); 
    
    /* ĐẶT NỀN TIÊU ĐỀ TRONG SUỐT */
    background-color: transparent; 
    
    /* Các thuộc tính cần thiết để tiêu đề hiển thị đúng */
    subcontrol-origin: margin;
    subcontrol-position: top left; /* Vị trí tiêu đề (ví dụ: ở giữa trên) */
    padding: 0 1px; /* Đệm xung quanh chữ tiêu đề */
    font-weight: bold;
}

QGroupBox {
    /* Thiết lập khung GroupBox */
    border: 1px solid black;
    border-radius: 5px;
    margin-top: 1.3em; /* Rất quan trọng để chừa chỗ cho tiêu đề */
    background-color: white; /* Màu nền của GroupBox */
    padding: 5px; /* Thêm padding cho nội dung bên trong */
}</string>
