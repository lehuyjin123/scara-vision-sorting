       <property name="geometry">
        <rect>
         <x>280</x>
         <y>90</y>
         <width>91</width>
         <height>31</height>
        </rect>
       </property>
       <property name="styleSheet">
        <string notr="true">QPushButton {
    /* Trạng thái mặc định */
    background-color: #007bff; /* Màu xanh dương cơ bản */
    color: white;
    border: none;
    padding: 4px 8px;
    border-radius: 10px;
    font-size: 11px;
    font-weight: bold;
    transition: background-color 0.3s ease; /* (Gợi ý: Dùng trong PySide/PyQt, có thể không thấy hiệu ứng trong Designer) */
}

QPushButton:hover {
    /* Khi di chuột qua (mouse hover) */
    background-color: #0056b3; /* Màu xanh dương đậm hơn */
    border: 2px solid #004085;
    cursor: pointer; /* Thay đổi con trỏ chuột (có thể không hoạt động trong Designer) */
}

QPushButton:pressed {
    /* Khi nút được nhấn xuống (mouse button pressed) */
    background-color: #004085; /* Màu xanh đậm nhất */
    padding-top: 14px; /* Tạo hiệu ứng &quot;nhấn xuống&quot; bằng cách thay đổi đệm */
    padding-bottom: 10px;
}

QPushButton:disabled {
    /* Khi nút bị vô hiệu hóa (disable) */
    background-color: #cccccc;
    color: #666666;
    border: 1px solid #999999;
}</string>
       </property>
       <property name="text">
        <string>SEND 2</string>
       </property>
      </widget>
     </widget>
     <widget class="QGroupBox" name="groupBox_14">
      <property name="geometry">
       <rect>
        <x>40</x>
        <y>350</y>
        <width>311</width>
        <height>181</height>
       </rect>
      </property>
      <property name="font">
       <font>
        <pointsize>9</pointsize>
        <weight>75</weight>
        <bold>true</bold>
       </font>
      </property>
      <property name="styleSheet">
       <string notr="true">QGroupBox::title {
    /* Khắc phục lỗi cú pháp: Màu chữ đen */
    color: rgb(0, 0, 0); 
    
    /* ĐẶT NỀN TIÊU ĐỀ TRONG SUỐT */
    background-color: transparent; 
    
    /* Các thuộc tính cần thiết để tiêu đề hiển thị đúng */
    subcontrol-origin: margin;
    subcontrol-position: top left; /* Vị trí tiêu đề (ví dụ: ở giữa trên) */
    padding: 0 1px; /* Đệm xung quanh chữ tiêu đề */
    font-weight: bold;
}

QGroupBox {
    /* Thiết lập khung GroupBox */
    border: 1px solid black;
    border-radius: 5px;
    margin-top: 1.3em; /* Rất quan trọng để chừa chỗ cho tiêu đề */
    background-color: white; /* Màu nền của GroupBox */
    padding: 5px; /* Thêm padding cho nội dung bên trong */
}</string>
