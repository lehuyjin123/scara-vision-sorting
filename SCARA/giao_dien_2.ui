        <string notr="true">QLabel {
    /* 1. Màu chữ (Color) */
    color: #c000000; /* Màu đỏ đô (Hex code) */
    
    /* 2. Cỡ chữ (Font Size) */
    font-size: 12px; /* Kích thước 20 pixels */
    
